_liqid_load_dotfiles_env() {
  local env_file="${DOTFILES_ENV_FILE:-$HOME/dotfiles/.env}"
  local docker_conf="${LIQID_DOCKER_CONF:-$HOME/.liqid/docker.conf}"

  if [[ -r "$env_file" ]]; then
    set -a
    source "$env_file"
    set +a
  elif [[ -r "$HOME/.env" ]]; then
    set -a
    source "$HOME/.env"
    set +a
  fi

  if [[ -r "$docker_conf" ]]; then
    # shellcheck source=/dev/null
    source "$docker_conf"
  fi
}

_liqid_need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required tool: $1" >&2
    return 1
  }
}

_liqid_trim() {
  printf '%s' "$1" | awk '{$1=$1}1'
}

_liqid_prompt() {
  local prompt="$1"
  local default="${2-}"
  local reply

  if [[ -n $default ]]; then
    printf '%s [%s]: ' "$prompt" "$default" >&2
  else
    printf '%s: ' "$prompt" >&2
  fi

  IFS= read -r reply || return 1
  printf '%s' "${reply:-$default}"
}

_liqid_fzf() {
  local prompt="$1"

  fzf \
    --height=80% \
    --reverse \
    --prompt="$prompt> " \
    --delimiter=$'\t' \
    --with-nth=1,2,3,4
}

_liqid_choose_line() {
  local prompt="$1"
  local choices="$2"
  local count idx i c1 c2 c3 c4 display

  [[ -n $choices ]] || {
    echo "No choices available." >&2
    return 1
  }

  if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$choices" | _liqid_fzf "$prompt"
    return
  fi

  count="$(printf '%s\n' "$choices" | wc -l | tr -d '[:space:]')"

  i=1
  while IFS=$'\t' read -r c1 c2 c3 c4; do
    display="$c1"
    [[ -n $c2 ]] && display="${display}  ${c2}"
    [[ -n $c3 ]] && display="${display}  ${c3}"
    [[ -n $c4 ]] && display="${display}  ${c4}"
    printf '%3d) %s\n' "$i" "$display" >&2
    ((i++))
  done <<< "$choices"

  if command -v fzf >/dev/null 2>&1; then
    echo "Run from an interactive terminal to use fzf; using numbered selection." >&2
  else
    echo "Install fzf for fuzzy search and filtering." >&2
  fi
  idx="$(_liqid_prompt "Pick number")" || return 1
  [[ "$idx" =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= count )) || {
    echo "Invalid selection." >&2
    return 1
  }

  printf '%s\n' "$choices" | sed -n "${idx}p"
}

_liqid_docker_username() {
  printf '%s' "${LIQID_DOCKER_USERNAME:-${DOCKER_HUB_USERNAME:-${DOCKER_USERNAME:-}}}"
}

_liqid_docker_password() {
  printf '%s' "${LIQID_DOCKER_PASSWORD:-${DOCKER_HUB_PASSWORD:-${DOCKER_PASSWORD:-}}}"
}

_liqid_docker_image() {
  printf '%s' "${LIQID_DOCKER_IMAGE:-liqid/liqid}"
}

_liqid_dev_container() {
  printf '%s' "${LIQID_DEV_CONTAINER:-dev}"
}

_liqid_dev_code_dir() {
  printf '%s' "${LIQID_DEV_CODE_DIR:-$HOME/code}"
}

_liqid_devsync_bin() {
  printf '%s' "${LIQID_DEVSYNC_BIN:-$HOME/bin/devsync}"
}

_liqid_local_tag_choices() {
  docker images "$(_liqid_docker_image)" --format '{{.Tag}}\t{{.ID}}\t{{.CreatedSince}}\t{{.Size}}' \
    | awk -F '\t' '$1 != "" && $1 != "<none>"'
}

_liqid_docker_ready() {
  _liqid_need docker || return 1

  docker ps >/dev/null 2>&1 || {
    echo "Docker is installed but not reachable. Check that Docker is running and your user can access the Docker socket." >&2
    return 1
  }
}

_liqid_remote_tags() {
  local image token user pass tag_pattern

  image="$(_liqid_docker_image)"
  user="$(_liqid_trim "$(_liqid_docker_username)")"
  pass="$(_liqid_trim "$(_liqid_docker_password)")"
  tag_pattern="${LIQID_DOCKER_TAG_PATTERN:-^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$}"

  if [[ -z $user || -z $pass ]]; then
    return 2
  fi

  token=$(
    curl -fsS -u "${user}:${pass}" \
      "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${image}:pull" \
      | jq -r '.token // empty'
  ) || return 1

  [[ -n $token ]] || return 1

  curl -fsS -H "Authorization: Bearer $token" \
    "https://registry-1.docker.io/v2/${image}/tags/list" \
    | jq -r '.tags[]' 2>/dev/null \
    | grep -E "$tag_pattern" \
    | sort -t. -k1,1nr -k2,2nr -k3,3nr -k4,4nr
}

_liqid_prompt_for_tag() {
  _liqid_prompt "Enter tag manually"
}

_liqid_select_local_tag() {
  local image choices selected

  image="$(_liqid_docker_image)"
  choices="$(_liqid_local_tag_choices)"

  if [[ -n $choices ]]; then
    choices="${choices}"$'\n'"Pull new tag"$'\t'"Fetch a tag from Docker Hub"
  else
    choices="Pull new tag"$'\t'"Fetch a tag from Docker Hub"
  fi

  selected="$(_liqid_choose_line "Local ${image} tag" "$choices")" || return 1
  printf '%s' "${selected%%$'\t'*}"
}

_liqid_select_remote_tag() {
  local remote_output remote_status choices selected tag

  _liqid_need curl || {
    echo "Falling back to manual tag entry." >&2
    _liqid_prompt_for_tag
    return 0
  }
  _liqid_need jq || {
    echo "Install jq to list/filter remote tags. Falling back to manual tag entry." >&2
    _liqid_prompt_for_tag
    return 0
  }

  remote_output="$(_liqid_remote_tags)"
  remote_status=$?

  if [[ $remote_status -eq 2 ]]; then
    echo "Docker credentials not set." >&2
    echo "Set them in $HOME/.liqid/docker.conf or dotfiles/.env." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  if [[ $remote_status -ne 0 ]]; then
    echo "Auth failed or tags could not be fetched. Check username/PAT and repo access." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  choices=""
  while IFS= read -r tag; do
    [[ -n $tag ]] && choices="${choices}${tag}"$'\t'"remote"$'\n'
  done <<< "$remote_output"
  choices="${choices%$'\n'}"

  if [[ -z $choices ]]; then
    echo "No matching remote tags retrieved." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  selected="$(_liqid_choose_line "Remote $(_liqid_docker_image) tag" "$choices")" || return 1
  printf '%s' "${selected%%$'\t'*}"
}

_liqid_container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

_liqid_container_running() {
  [[ "$(docker container inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]
}

_liqid_container_host_pid() {
  docker container inspect -f '{{.State.Pid}}' "$1" 2>/dev/null
}

_liqid_container_id() {
  docker container inspect -f '{{.Id}}' "$1" 2>/dev/null
}

_liqid_container_cgroup_path() {
  local container="$1"
  local pid cgroup

  pid="$(_liqid_container_host_pid "$container")" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 0 )) || return 1

  cgroup="$(awk -F: '$1 == "0" {print $3}' "/proc/$pid/cgroup" 2>/dev/null)" || return 1
  [[ -n $cgroup ]] || return 1

  printf '/sys/fs/cgroup%s' "$cgroup"
}

_liqid_confirm() {
  local prompt="$1"
  local reply

  [[ -t 0 ]] || return 1
  reply="$(_liqid_prompt "$prompt" "n")" || return 1

  case "$reply" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

_liqid_dev_confirm_stuck_cleanup() {
  local container="$1"
  local pid

  case "${LIQID_DEV_STUCK_CLEANUP:-}" in
    1|true|TRUE|yes|YES|y|Y) return 0 ;;
  esac

  pid="$(_liqid_container_host_pid "$container" 2>/dev/null || true)"
  cat >&2 <<EOF
Docker could not stop '$container' cleanly.
This usually means Docker/containerd did not receive the container exit event because a process inside the container is stuck in uninterruptible kernel sleep (D state).
The thorough cleanup will try cgroup.kill and may SIGKILL this container's matching containerd shim, then retry docker rm -f.
EOF
  [[ -n $pid ]] && echo "Docker-reported host pid: $pid" >&2

  if [[ ! -t 0 ]]; then
    echo "Run from an interactive terminal to approve thorough cleanup, or set LIQID_DEV_STUCK_CLEANUP=1." >&2
    return 1
  fi

  _liqid_confirm "Continue with thorough cleanup?"
}

_liqid_sudo_kill_pid() {
  local pid="$1"

  command -v sudo >/dev/null 2>&1 || return 1

  if [[ -t 0 ]]; then
    sudo kill -KILL "$pid"
  else
    sudo -n kill -KILL "$pid" 2>/dev/null
  fi
}

_liqid_kill_pid() {
  local pid="$1"
  local label="$2"

  [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 0 )) || return 1
  [[ -d "/proc/$pid" ]] || return 0

  echo "SIGKILL ${label} pid $pid..." >&2
  kill -KILL "$pid" 2>/dev/null || _liqid_sudo_kill_pid "$pid" || return 1
  sleep 1
  [[ ! -d "/proc/$pid" ]]
}

_liqid_kill_cgroup() {
  local cgroup_path="$1"
  local kill_file="${cgroup_path}/cgroup.kill"

  [[ -e $kill_file ]] || return 1

  echo "Killing container cgroup..." >&2
  if [[ -w $kill_file ]]; then
    printf '1' > "$kill_file"
  elif command -v sudo >/dev/null 2>&1; then
    if [[ -t 0 ]]; then
      printf '1\n' | sudo tee "$kill_file" >/dev/null
    else
      printf '1\n' | sudo -n tee "$kill_file" >/dev/null 2>&1
    fi
  else
    return 1
  fi
  sleep 1
}

_liqid_kill_container_shim() {
  local container="$1"
  local pid ppid cid cmdline

  pid="$(_liqid_container_host_pid "$container" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 0 )) || return 1
  [[ -r "/proc/$pid/status" ]] || return 1

  ppid="$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)"
  [[ "$ppid" =~ ^[0-9]+$ ]] && (( ppid > 1 )) || return 1
  [[ -r "/proc/$ppid/cmdline" ]] || return 1

  cid="$(_liqid_container_id "$container")" || return 1
  cmdline="$(tr '\0' ' ' < "/proc/$ppid/cmdline" 2>/dev/null)" || return 1
  [[ $cmdline == *containerd-shim*"$cid"* ]] || return 1

  _liqid_kill_pid "$ppid" "containerd shim"
}

_liqid_dev_thorough_cleanup() {
  local container="$1"
  local cgroup_path="$2"
  local pid

  if ! _liqid_container_uses_liqid_image "$container"; then
    echo "Refusing thorough cleanup for '$container': image does not match $(_liqid_docker_image)." >&2
    return 1
  fi

  docker kill --signal=KILL "$container" >/dev/null 2>&1 || true
  pid="$(_liqid_container_host_pid "$container" 2>/dev/null || true)"
  [[ -n $pid ]] && _liqid_kill_pid "$pid" "container init" || true
  [[ -n $cgroup_path ]] && _liqid_kill_cgroup "$cgroup_path" || true
  pid="$(_liqid_container_host_pid "$container" 2>/dev/null || true)"
  [[ -n $pid ]] && _liqid_kill_pid "$pid" "container init" || true
  _liqid_kill_container_shim "$container" || true
  [[ -n $cgroup_path ]] && _liqid_kill_cgroup "$cgroup_path" || true
}

_liqid_cgroup_procs() {
  local cgroup_path="$1"
  local procs

  [[ -r "${cgroup_path}/cgroup.procs" ]] || return 1
  procs="$(tr '\n' ' ' < "${cgroup_path}/cgroup.procs" 2>/dev/null)" || return 1
  _liqid_trim "$procs"
}

_liqid_dev_remove_succeeded() {
  local container="$1"
  local cgroup_path="$2"
  local procs ps_pids

  [[ -n $cgroup_path ]] || return 0

  procs="$(_liqid_cgroup_procs "$cgroup_path")" || return 0
  [[ -z $procs ]] && return 0
  ps_pids="${procs// /,}"

  echo "Docker removed '$container', but cgroup still contains pids: $procs" >&2
  ps -p "$ps_pids" -o pid,ppid,stat,comm,args >&2 2>/dev/null || true
  if ps -p "$ps_pids" -o stat= 2>/dev/null | awk '$1 ~ /D/ { found = 1 } END { exit found ? 0 : 1 }'; then
    echo "A process with STAT D is stuck in uninterruptible kernel sleep and cannot be killed by Docker, kill, or sudo kill." >&2
  else
    echo "Some container processes remain after Docker removal." >&2
  fi
  echo "On WSL, save your work and run 'wsl --shutdown' from PowerShell to clear the remaining kernel-stuck process." >&2
  return 1
}

_liqid_dev_remove_container() {
  local container="$1"
  local cgroup_path rm_output stuck_cleanup

  stuck_cleanup=0
  cgroup_path="$(_liqid_container_cgroup_path "$container" 2>/dev/null || true)"

  if _liqid_container_running "$container"; then
    echo "Stopping $container..." >&2
    if ! docker stop --time 10 "$container" >/dev/null; then
      _liqid_dev_confirm_stuck_cleanup "$container" || return 1
      stuck_cleanup=1
      _liqid_dev_thorough_cleanup "$container" "$cgroup_path" || true
    fi
  fi

  echo "Removing $container..." >&2
  if rm_output="$(docker rm "$container" 2>&1)"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi
  if ! _liqid_container_exists "$container"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi

  if rm_output="$(docker rm -f "$container" 2>&1)"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi
  if ! _liqid_container_exists "$container"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi

  if [[ $stuck_cleanup -eq 0 ]]; then
    [[ -n $rm_output ]] && printf '%s\n' "$rm_output" >&2
    _liqid_dev_confirm_stuck_cleanup "$container" || return 1
  fi

  _liqid_dev_thorough_cleanup "$container" "$cgroup_path" || true
  if rm_output="$(docker rm -f "$container" 2>&1)"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi
  if ! _liqid_container_exists "$container"; then
    _liqid_dev_remove_succeeded "$container" "$cgroup_path"
    return $?
  fi

  [[ -n $rm_output ]] && printf '%s\n' "$rm_output" >&2
  echo "Unable to remove '$container'. Docker may have stale runtime state; restart Docker and retry 'liqid_dev stop $container'." >&2
  return 1
}

_liqid_dev_container_state() {
  local container="$1"
  local state image

  if ! command -v docker >/dev/null 2>&1; then
    printf '%s' "docker missing"
    return 0
  fi

  state="$(docker container inspect -f '{{.State.Status}}' "$container" 2>/dev/null)" || {
    if docker ps >/dev/null 2>&1; then
      printf '%s' "not created"
    else
      printf '%s' "docker unavailable"
    fi
    return 0
  }

  image="$(docker container inspect -f '{{.Config.Image}}' "$container" 2>/dev/null)"
  printf '%s' "$state"
  [[ -n $image ]] && printf '  %s' "$image"
}

_liqid_dev_container_name() {
  local container="${1:-$(_liqid_dev_container)}"

  [[ -n $container ]] || {
    echo "Container name cannot be empty." >&2
    return 1
  }

  printf '%s' "$container"
}

_liqid_dev_single_container_arg() {
  local usage="$1"
  shift

  if [[ $# -gt 1 ]]; then
    echo "Usage: $usage" >&2
    return 1
  fi

  _liqid_dev_container_name "${1-}"
}

_liqid_container_uses_liqid_image() {
  local container="$1"
  local image repo

  repo="$(_liqid_docker_image)"
  image="$(docker container inspect -f '{{.Config.Image}}' "$container" 2>/dev/null)" || return 1

  [[ "$image" == "$repo" || "$image" == "$repo:"* || "$image" == "$repo@"* ]]
}

_liqid_dev_container_choices() {
  local image

  image="$(_liqid_docker_image)"

  docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}' \
    | awk -F '\t' -v image="$image" '
      $2 == image || index($2, image ":") == 1 || index($2, image "@") == 1 { print }
    '
}

_liqid_dev_require_container() {
  local container="$1"

  _liqid_docker_ready || return 1

  if ! _liqid_container_exists "$container"; then
    echo "Container '$container' does not exist. Run 'liqid_dev make $container' first." >&2
    return 1
  fi

  if ! _liqid_container_running "$container"; then
    echo "Starting stopped Liqid dev container '$container'..." >&2
    docker start "$container" >/dev/null || return 1
  fi
}

_liqid_dev_status() {
  local container image state choices name c_image status

  if [[ $# -gt 1 ]]; then
    echo "Usage: liqid_dev status [container]" >&2
    return 1
  fi

  _liqid_docker_ready || return 1

  image="$(_liqid_docker_image)"
  printf 'Image repo: %s\n' "$image"

  if [[ $# -eq 1 ]]; then
    container="$(_liqid_dev_container_name "$1")" || return 1
    printf 'Container: %s\n' "$container"

    if ! _liqid_container_exists "$container"; then
      printf 'State: not created\n'
      return 0
    fi

    state="$(docker container inspect -f '{{.State.Status}}' "$container" 2>/dev/null)"
    c_image="$(docker container inspect -f '{{.Config.Image}}' "$container" 2>/dev/null)"
    printf 'State: %s\n' "${state:-unknown}"
    printf 'Image: %s\n' "${c_image:-unknown}"
    return 0
  fi

  choices="$(_liqid_dev_container_choices)"
  if [[ -z $choices ]]; then
    printf 'Containers: none\n'
    printf 'Default container: %s\n' "$(_liqid_dev_container)"
    return 0
  fi

  printf 'Containers:\n'
  while IFS=$'\t' read -r name c_image status; do
    [[ -n $name ]] && printf '  %-24s %-32s %s\n' "$name" "$c_image" "$status"
  done <<< "$choices"
}

_liqid_dev_command_choices() {
  local container state

  container="$(_liqid_dev_container)"
  state="$(_liqid_dev_container_state "$container")"

  cat <<EOF
make	Build and start a fresh Liqid dev container	$state
enter	Open an interactive shell	$state
sync	Run devsync inside the container	$state
exec	Run a command inside the container	$state
stop	Stop and remove a Liqid dev container	$state
status	Show container state and image	$state
help	Show usage
EOF
}

_liqid_select_dev_command() {
  local selected

  selected="$(_liqid_choose_line "Liqid dev" "$(_liqid_dev_command_choices)")" || return 1
  printf '%s' "${selected%%$'\t'*}"
}

_liqid_dev_make() {
  local image container make_tag choice tag code_dir devsync_bin
  local -a docker_args

  _liqid_docker_ready || return 1

  image="$(_liqid_docker_image)"
  container="$(_liqid_dev_container_name "${1-}")" || return 1
  code_dir="$(_liqid_dev_code_dir)"
  devsync_bin="$(_liqid_devsync_bin)"

  [[ -d $code_dir ]] || {
    echo "Code directory not found: $code_dir" >&2
    return 1
  }

  make_tag="$(_liqid_select_local_tag)" || return 1

  if [[ $make_tag == "Pull new tag" ]]; then
    echo "Fetching remote tags for ${image}..." >&2
    choice="$(_liqid_select_remote_tag)" || return 1
    if [[ -n $choice ]]; then
      docker pull "${image}:${choice}" || return 1
    fi
  fi

  tag="${choice:-$make_tag}"
  [[ -n $tag ]] || {
    echo "No tag selected." >&2
    return 1
  }

  if _liqid_container_exists "$container"; then
    echo "Replacing existing Liqid dev container '$container'..." >&2
    _liqid_dev_remove_container "$container" || return 1
  fi

  docker_args=(
    -d
    --name "$container"
    --network host
    --label "liqid.dev=true"
    --label "liqid.dev.image=${image}"
    -v "${code_dir}:/mnt/code"
  )

  if [[ -d "$HOME/.ssh" ]]; then
    docker_args+=(-v "$HOME/.ssh:/root/.ssh:ro")
  fi

  if [[ -f $devsync_bin ]]; then
    docker_args+=(-v "$devsync_bin:/usr/local/bin/devsync:ro")
  else
    echo "devsync not found at $devsync_bin; 'liqid_dev sync' may fail." >&2
  fi

  echo "Starting ${image}:${tag} as ${container}..." >&2
  docker run "${docker_args[@]}" "${image}:${tag}"
}

_liqid_dev_exec() {
  local container cmd

  container="$(_liqid_dev_container)"

  case "${1-}" in
    -c|--container|--name)
      shift
      [[ $# -gt 0 ]] || {
        echo "Missing container name." >&2
        return 1
      }
      container="$(_liqid_dev_container_name "$1")" || return 1
      shift
      ;;
    --)
      shift
      ;;
    *)
      if [[ $# -gt 1 && "${2-}" == "--" ]]; then
        container="$(_liqid_dev_container_name "$1")" || return 1
        shift 2
      elif [[ $# -gt 0 ]] && _liqid_container_exists "$1"; then
        container="$(_liqid_dev_container_name "$1")" || return 1
        shift
      fi
      ;;
  esac

  _liqid_dev_require_container "$container" || return 1
  if [[ $# -eq 0 ]]; then
    cmd="$(_liqid_prompt "Command")" || return 1
    [[ -n $cmd ]] || {
      echo "No command provided." >&2
      return 1
    }
    set -- "$cmd"
  fi

  docker exec -it "$container" bash -lc "$*"
}

_liqid_dev_stop() {
  local image container choices selected name c_image status failed
  local -a containers

  _liqid_docker_ready || return 1

  image="$(_liqid_docker_image)"

  if [[ $# -eq 0 ]]; then
    choices="$(_liqid_dev_container_choices)"
    [[ -n $choices ]] || {
      echo "No ${image} containers found." >&2
      return 0
    }

    selected="$(
      _liqid_choose_line \
        "Stop Liqid container" \
        "All matching containers"$'\t'"stop and remove every ${image} container"$'\n'"$choices"
    )" || return 1
    container="${selected%%$'\t'*}"

    if [[ $container == "All matching containers" ]]; then
      while IFS=$'\t' read -r name c_image status; do
        [[ -n $name ]] && containers+=("$name")
      done <<< "$choices"
    else
      containers+=("$container")
    fi
  else
    containers=("$@")
  fi

  failed=0
  for container in "${containers[@]}"; do
    if ! _liqid_container_exists "$container"; then
      echo "Container '$container' does not exist." >&2
      failed=1
      continue
    fi

    if ! _liqid_container_uses_liqid_image "$container"; then
      c_image="$(docker container inspect -f '{{.Config.Image}}' "$container" 2>/dev/null)"
      echo "Refusing to remove '$container': image '${c_image:-unknown}' does not match ${image}." >&2
      failed=1
      continue
    fi

    _liqid_dev_remove_container "$container" || {
      failed=1
      continue
    }
  done

  return "$failed"
}

liqid_dev() {
  local cmd container

  _liqid_load_dotfiles_env

  if [[ $# -eq 0 ]]; then
    cmd="$(_liqid_select_dev_command)" || return 1
    set -- "$cmd"
  fi

  case "$1" in
    make)
      shift
      container="$(_liqid_dev_single_container_arg "liqid_dev make [container]" "$@")" || return 1
      _liqid_dev_make "$container"
      ;;
    enter)
      shift
      container="$(_liqid_dev_single_container_arg "liqid_dev enter [container]" "$@")" || return 1
      _liqid_dev_require_container "$container" || return 1
      docker exec -it "$container" bash --login -i
      ;;
    sync)
      shift
      container="$(_liqid_dev_single_container_arg "liqid_dev sync [container]" "$@")" || return 1
      _liqid_dev_require_container "$container" || return 1
      docker exec -it "$container" bash -lc devsync
      ;;
    exec)
      shift
      _liqid_dev_exec "$@"
      ;;
    stop|rm|remove)
      shift
      _liqid_dev_stop "$@"
      ;;
    status)
      shift
      _liqid_dev_status "$@"
      ;;
    help|*)
      cat <<EOF
Usage: liqid_dev <command> [container]

Commands:
  make [container]          Build and start a fresh Liqid dev container
  enter [container]         Exec into a Liqid dev container with an interactive bash shell
  sync [container]          Run devsync inside a Liqid dev container
  exec [container] -- CMD   Run an arbitrary command inside a Liqid dev container
  stop [container ...]      Stop and remove selected Liqid dev containers
  status [container]        Show Liqid dev container state and image
  help                      Show this message

Default container: $(_liqid_dev_container)
EOF
      ;;
  esac
}

dev() {
  liqid_dev "$@"
}

bbdl() (
  local conf="${BITBUCKET_CONF:-$HOME/.liqid/bitbucket.conf}"
  local user token workspace repo filename dest_dir tmpdir refresh_cache force_filename
  local cache_root cache_ttl cache_workspace cache_repo cache_dir cache_file cache_lock_dir cache_refresh_started

  _liqid_load_dotfiles_env

  if [[ -r "$conf" ]]; then
    # shellcheck source=/dev/null
    source "$conf"
  fi

  user="${BITBUCKET_USERNAME:-}"
  token="${BITBUCKET_APP_PASSWORD:-}"
  workspace="${BITBUCKET_WORKSPACE:-${BITBUCKET_REPO_OWNER:-${BITBUCKET_REPRO_OWNER:-liqid}}}"
  repo=""
  filename=""
  dest_dir="${BITBUCKET_DOWNLOAD_DIR:-$PWD}"
  refresh_cache=0
  force_filename=0
  cache_refresh_started=0

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      -h|--help|help)
      cat <<EOF
Usage: bbdl [repo]
       bbdl [workspace] [repo]
       bbdl [repo] [filename]
       bbdl [workspace] [repo] [filename]

With no repo, bbdl prompts for a Bitbucket workspace and repository.

Options:
  --refresh            Ignore cached download metadata for this run
  --filename           Treat two positional args as repo + filename

Config:
  BITBUCKET_USERNAME
  BITBUCKET_APP_PASSWORD
  BITBUCKET_WORKSPACE      Optional, defaults to liqid
  BITBUCKET_DOWNLOAD_DIR   Optional, defaults to current directory
  BBDL_CACHE_TTL           Optional seconds before cache is stale, defaults to 3600
EOF
      return 0
      ;;
      --refresh)
        refresh_cache=1
        shift
        ;;
      --filename|--file)
        force_filename=1
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Unknown option: $1" >&2
        return 1
        ;;
      *)
        break
        ;;
  esac
  done

  case $# in
    0)
      ;;
    1)
      if (( force_filename )); then
        echo "--filename requires repo and filename." >&2
        return 1
      fi
      repo="$1"
      ;;
    2)
      if (( force_filename )) || { [[ "$1" != "$workspace" ]] && [[ "$2" == *.* || "$2" == */* ]]; }; then
        repo="$1"
        filename="$2"
      else
        workspace="$1"
        repo="$2"
      fi
      ;;
    3)
      workspace="$1"
      repo="$2"
      filename="$3"
      ;;
    *)
      echo "Usage: bbdl [repo], bbdl [workspace] [repo], or bbdl [repo] [filename]" >&2
      return 1
      ;;
  esac

  if [[ -z "$user" || -z "$token" ]]; then
    echo "BITBUCKET_USERNAME and BITBUCKET_APP_PASSWORD must be set." >&2
    echo "Set them in $conf, dotfiles/.env, or your shell environment." >&2
    return 1
  fi

  _liqid_need curl || return 1
  _liqid_need jq || return 1

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/bbdl.XXXXXX")" || return 1
  trap 'rm -rf "$tmpdir"' EXIT

  _bbdl_prompt() {
    local prompt="$1"
    local default="${2-}"
    local reply

    if [[ -n "$default" ]]; then
      printf '%s [%s]: ' "$prompt" "$default" >&2
    else
      printf '%s: ' "$prompt" >&2
    fi

    IFS= read -r reply || return 1
    printf '%s' "${reply:-$default}"
  }

  _bbdl_expand_path() {
    case "$1" in
      "~")
        printf '%s' "$HOME"
        ;;
      "~/"*)
        printf '%s/%s' "$HOME" "${1#~/}"
        ;;
      *)
        printf '%s' "$1"
        ;;
    esac
  }

  _bbdl_urlencode() {
    jq -rn --arg value "$1" '$value | @uri'
  }

  _bbdl_cache_key() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
  }

  _bbdl_file_mtime() {
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
  }

  _bbdl_current_pid() {
    printf '%s' "${BASHPID:-$$}"
  }

  _bbdl_api_values() {
    local url="$1"
    local body

    while [[ -n "$url" ]]; do
      body="$(curl -fsS \
        -u "$user:$token" \
        -H "Accept: application/json" \
        --connect-timeout 15 \
        --max-time 120 \
        "$url")" || {
          echo >&2
          echo "Bitbucket request failed." >&2
          echo "Check username, app-password scopes, repo permissions, and workspace access." >&2
          return 1
        }

      jq -e '.values? // []' >/dev/null <<< "$body" || {
        echo "Bitbucket returned invalid JSON for: $url" >&2
        return 1
      }

      jq -c '.values[]?' <<< "$body" || return 1
      url="$(jq -r '.next // empty' <<< "$body")" || return 1
    done
  }

  _bbdl_downloads_url() {
    local pagelen="${1:-100}"
    local sort="${2-}"
    local fields="values.name,values.size,values.created_on,values.links.self.href,next,size,pagelen,page"

    printf 'https://api.bitbucket.org/2.0/repositories/%s/%s/downloads?pagelen=%s&fields=%s' \
      "$workspace" "$repo" "$pagelen" "$fields"

    if [[ -n "$sort" ]]; then
      printf '&sort=%s' "$sort"
    fi
  }

  _bbdl_download_url() {
    local encoded

    encoded="$(_bbdl_urlencode "$1")" || return 1
    printf 'https://api.bitbucket.org/2.0/repositories/%s/%s/downloads/%s' \
      "$workspace" "$repo" "$encoded"
  }

  _bbdl_fetch_downloads_to_file() {
    local url="$1"
    local outfile="$2"
    local max_items="${3:-0}"
    local show_progress="${4:-1}"
    local body page page_count fetched total total_text remaining

    : > "$outfile" || return 1
    page=1
    fetched=0
    total=""

    while [[ -n "$url" ]]; do
      body="$(curl -fsS \
        -u "$user:$token" \
        -H "Accept: application/json" \
        --connect-timeout 15 \
        --max-time 120 \
        "$url")" || {
          echo >&2
          echo "Bitbucket request failed while fetching downloads page $page." >&2
          echo "Check username, app-password scopes, repo permissions, and workspace access." >&2
          return 1
        }

      jq -e '.values? // []' >/dev/null <<< "$body" || {
        echo "Bitbucket returned invalid JSON while fetching downloads page $page." >&2
        return 1
      }

      page_count="$(jq '.values | length' <<< "$body")" || return 1
      [[ -z "$total" ]] && total="$(jq -r '.size // empty' <<< "$body")"

      if (( max_items > 0 && fetched + page_count > max_items )); then
        remaining=$((max_items - fetched))
        if (( remaining > 0 )); then
          jq -c --argjson n "$remaining" '.values[:$n][]?' <<< "$body" >> "$outfile" || return 1
          fetched=$max_items
        fi
        url=""
      else
        jq -c '.values[]?' <<< "$body" >> "$outfile" || return 1
        fetched=$((fetched + page_count))
        url="$(jq -r '.next // empty' <<< "$body")" || return 1
      fi

      if (( show_progress )); then
        total_text=""
        [[ -n "$total" ]] && total_text=" of $total"
        if (( page == 1 || page % 5 == 0 )) || [[ -z "$url" ]]; then
          echo "Fetched $fetched$total_text downloads..." >&2
        fi
      fi

      (( max_items > 0 && fetched >= max_items )) && break
      page=$((page + 1))
    done
  }

  _bbdl_render_choices_from_jsonl() {
    local input="$1"
    local output="$2"
    local limit="${3:-0}"
    local query="${4-}"

    [[ "$limit" =~ ^[0-9]+$ ]] || limit=0

    jq -s -r --arg q "$query" --argjson n "$limit" '
      map(select(
        ($q == "")
        or (((.name // "") | ascii_downcase) | contains($q | ascii_downcase))
      ))
      | sort_by(.created_on // "")
      | reverse
      | (if $n > 0 then .[0:$n] else . end)
      | .[]
      | [.name, ((.size // 0) | tostring), (.created_on // ""), (.links.self.href // "")]
      | @tsv
    ' "$input" > "$output"
  }

  _bbdl_fzf() {
    local prompt="$1"

    fzf \
      --height=80% \
      --reverse \
      --prompt="$prompt> " \
      --delimiter=$'\t' \
      --with-nth=1,2,3
  }

  _bbdl_stream_choices() {
    local query="$1"
    local url="$2"
    local cache_tmp="${3-}"
    local show_progress="${4:-0}"
    local body page page_count fetched total total_text

    if [[ -n "$cache_tmp" ]]; then
      : > "$cache_tmp" || return 1
    fi

    page=1
    fetched=0
    total=""

    while [[ -n "$url" ]]; do
      body="$(curl -fsS \
        -u "$user:$token" \
        -H "Accept: application/json" \
        --connect-timeout 15 \
        --max-time 120 \
        "$url")" || return 1

      jq -e '.values? // []' >/dev/null <<< "$body" || return 1

      if [[ -n "$cache_tmp" ]]; then
        jq -c '.values[]?' <<< "$body" >> "$cache_tmp" || return 1
      fi

      jq -r --arg q "$query" '
        .values[]?
        | select(
          ($q == "")
          or (((.name // "") | ascii_downcase) | contains($q | ascii_downcase))
        )
        | [.name, ((.size // 0) | tostring), (.created_on // ""), (.links.self.href // "")]
        | @tsv
      ' <<< "$body" || return 1

      page_count="$(jq '.values | length' <<< "$body")" || return 1
      fetched=$((fetched + page_count))
      [[ -z "$total" ]] && total="$(jq -r '.size // empty' <<< "$body")"
      url="$(jq -r '.next // empty' <<< "$body")" || return 1

      if (( show_progress )); then
        total_text=""
        [[ -n "$total" ]] && total_text=" of $total"
        if (( page == 1 || page % 5 == 0 )) || [[ -z "$url" ]]; then
          echo "Fetched $fetched$total_text downloads..." >&2
        fi
      fi

      page=$((page + 1))
    done

    if [[ -n "$cache_tmp" ]]; then
      mv "$cache_tmp" "$cache_file"
    fi
  }

  _bbdl_stream_pick() {
    local query="$1"
    local url="$2"
    local cache_tmp="$3"
    local fifo err_file producer_pid selected fzf_status producer_status

    fifo="$tmpdir/stream.$RANDOM"
    err_file="$tmpdir/stream.$RANDOM.err"
    mkfifo "$fifo" || return 1

    (
      trap - EXIT
      _bbdl_stream_choices "$query" "$url" "$cache_tmp" 0 > "$fifo"
    ) 2> "$err_file" &
    producer_pid=$!

    selected="$(_bbdl_fzf "Download" < "$fifo")"
    fzf_status=$?

    kill "$producer_pid" 2>/dev/null || true
    producer_status=0
    wait "$producer_pid" 2>/dev/null || producer_status=$?
    rm -f "$fifo"

    if [[ -z "$selected" && "$producer_status" -ne 0 && -s "$err_file" ]]; then
      grep -v -E 'Broken pipe|writing output failed' "$err_file" >&2 || true
    fi
    rm -f "$err_file"

    printf '%s' "$selected"
    return "$fzf_status"
  }

  _bbdl_choose_line() {
    local prompt="$1"
    local file="$2"
    local count idx i limit c1 c2 c3 c4

    if [[ ! -s "$file" ]]; then
      echo "No matches." >&2
      return 1
    fi

    if command -v fzf >/dev/null 2>&1; then
      _bbdl_fzf "$prompt" < "$file"
      return
    fi

    count="$(wc -l < "$file" | tr -d '[:space:]')"
    limit="$count"

    if (( count > 50 )); then
      echo "Showing first 50 of $count matches. Install fzf for a much better fuzzy picker." >&2
      limit=50
    fi

    i=1
    while IFS=$'\t' read -r c1 c2 c3 c4; do
      printf '%3d) %-60s %12s %s\n' "$i" "$c1" "$c2" "$c3"
      ((i++))
      if (( i > limit )); then
        break
      fi
    done < "$file"

    idx="$(_bbdl_prompt "Pick number")" || return 1
    [[ "$idx" =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= count )) || {
      echo "Invalid selection." >&2
      return 1
    }

    sed -n "${idx}p" "$file"
  }

  _bbdl_cache_state() {
    local mtime now age

    [[ -s "$cache_file" ]] || {
      printf '%s' "missing"
      return 0
    }

    mtime="$(_bbdl_file_mtime "$cache_file")" || {
      printf '%s' "stale"
      return 0
    }
    now="$(date +%s)"
    age=$((now - mtime))

    if (( age <= cache_ttl )); then
      printf '%s' "fresh"
    else
      printf '%s' "stale"
    fi
  }

  _bbdl_mark_cache_lock() {
    local pid="$1"

    (
      printf '%s\n' "$pid" > "$cache_lock_dir/pid"
      date +%s > "$cache_lock_dir/started"
    ) 2>/dev/null || true
  }

  _bbdl_cache_lock_active() {
    local pid started now age max_age

    [[ -r "$cache_lock_dir/pid" ]] || return 1
    IFS= read -r pid < "$cache_lock_dir/pid" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1

    max_age="${BBDL_CACHE_LOCK_TTL:-7200}"
    [[ "$max_age" =~ ^[0-9]+$ ]] || max_age=7200

    if [[ -r "$cache_lock_dir/started" ]]; then
      IFS= read -r started < "$cache_lock_dir/started" || started=""
      if [[ "$started" =~ ^[0-9]+$ ]]; then
        now="$(date +%s)"
        age=$((now - started))
        (( age <= max_age )) || return 1
      fi
    fi

    kill -0 "$pid" 2>/dev/null
  }

  _bbdl_clear_cache_lock() {
    rm -f "$cache_lock_dir/pid" "$cache_lock_dir/started" 2>/dev/null || true
    rmdir "$cache_lock_dir" 2>/dev/null || true
  }

  _bbdl_acquire_cache_lock() {
    mkdir -p "$cache_dir" || return 1

    if mkdir "$cache_lock_dir" 2>/dev/null; then
      _bbdl_mark_cache_lock "$(_bbdl_current_pid)"
      return 0
    fi

    if ! _bbdl_cache_lock_active; then
      _bbdl_clear_cache_lock
      if mkdir "$cache_lock_dir" 2>/dev/null; then
        _bbdl_mark_cache_lock "$(_bbdl_current_pid)"
        return 0
      fi
    fi

    return 1
  }

  _bbdl_release_cache_lock() {
    _bbdl_clear_cache_lock
  }

  _bbdl_start_background_refresh() {
    local tmp refresh_pid

    (( cache_refresh_started )) && return 0
    cache_refresh_started=1

    if ! _bbdl_acquire_cache_lock; then
      echo "Download cache refresh is already running." >&2
      return 0
    fi

    echo "Refreshing download cache in the background." >&2

    tmp="${cache_file}.$$.$RANDOM.tmp"
    (
      trap '[[ -n "$tmp" ]] && rm -f "$tmp"; _bbdl_release_cache_lock' EXIT
      if _bbdl_fetch_downloads_to_file "$(_bbdl_downloads_url 100 "")" "$tmp" 0 0; then
        mv "$tmp" "$cache_file"
        tmp=""
      else
        rm -f "$tmp"
        tmp=""
      fi
    ) >/dev/null 2>&1 &
    refresh_pid=$!
    _bbdl_mark_cache_lock "$refresh_pid"
  }

  _bbdl_use_cache() {
    local state

    (( refresh_cache )) && return 1
    [[ -s "$cache_file" ]] || return 1

    state="$(_bbdl_cache_state)"
    if [[ "$state" == "stale" ]]; then
      echo "Using cached downloads for $workspace/$repo; cache is stale." >&2
      _bbdl_start_background_refresh
    else
      echo "Using cached downloads for $workspace/$repo." >&2
    fi

    return 0
  }

  _bbdl_refresh_cache_foreground() {
    local tmp

    mkdir -p "$cache_dir" || return 1
    tmp="${cache_file}.$$.$RANDOM.tmp"

    echo "Fetching downloads for $workspace/$repo..." >&2
    if _bbdl_fetch_downloads_to_file "$(_bbdl_downloads_url 100 "")" "$tmp" 0 1; then
      mv "$tmp" "$cache_file"
    else
      rm -f "$tmp"
      return 1
    fi

    if [[ ! -s "$cache_file" ]]; then
      echo "No downloads found for $workspace/$repo" >&2
      return 1
    fi
  }

  _bbdl_download_file() {
    local name="$1"
    local href="$2"
    local dest_in out yn

    if [[ -z "$href" ]]; then
      echo "Selected download has no download URL." >&2
      return 1
    fi

    echo "Selected: $name" >&2
    dest_in="$(_bbdl_prompt "Download directory" "$dest_dir")" || return 1
    dest_dir="$(_bbdl_expand_path "$dest_in")"
    mkdir -p "$dest_dir" || return 1

    out="${dest_dir%/}/${name##*/}"

    if [[ -e "$out" ]]; then
      yn="$(_bbdl_prompt "File exists. Overwrite $out?" "N")" || return 1
      [[ "$yn" =~ ^[Yy]$ ]] || {
        echo "Skipped." >&2
        return 0
      }
    fi

    echo "Downloading to: $out" >&2
    curl -fL \
      --progress-bar \
      --connect-timeout 15 \
      --max-time 0 \
      -u "$user:$token" \
      "$href" \
      -o "$out" || return 1

    echo "Done: $out" >&2
  }

  if [[ -z "$repo" ]]; then
    local ws_in repo_choices selected_repo repo_name
    ws_in="$(_bbdl_prompt "Workspace" "$workspace")" || return 1
    workspace="$ws_in"

    echo "Fetching repositories for workspace: $workspace" >&2
    repo_choices="$tmpdir/repos.tsv"
    _bbdl_api_values "https://api.bitbucket.org/2.0/repositories/${workspace}?pagelen=100&sort=name" \
      | jq -r '[.slug, (.name // .slug), (.updated_on // "")] | @tsv' \
      > "$repo_choices" || return 1

    selected_repo="$(_bbdl_choose_line "Repo" "$repo_choices")" || return 1
    IFS=$'\t' read -r repo repo_name _ <<< "$selected_repo"
  fi

  echo "Selected repo: $workspace/$repo" >&2

  cache_root="${BBDL_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/bbdl}"
  cache_ttl="${BBDL_CACHE_TTL:-${BITBUCKET_DOWNLOAD_CACHE_TTL:-3600}}"
  [[ "$cache_ttl" =~ ^[0-9]+$ ]] || cache_ttl=3600
  cache_workspace="$(_bbdl_cache_key "$workspace")"
  cache_repo="$(_bbdl_cache_key "$repo")"
  cache_dir="${cache_root%/}/${cache_workspace}/${cache_repo}"
  cache_file="${cache_dir}/downloads.jsonl"
  cache_lock_dir="${cache_dir}/refresh.lock"

  if [[ -n "$filename" ]]; then
    local direct_href
    direct_href="$(_bbdl_download_url "$filename")" || return 1
    _bbdl_download_file "$filename" "$direct_href"
    return
  fi

  while true; do
    local mode n query choices selected name size created href again pagelen tmp_limited cache_tmp
    selected=""

    echo >&2
    echo "Find a download:" >&2
    echo "  1) Newest N downloads" >&2
    echo "  2) Search filenames" >&2
    echo "  3) Show all, newest first" >&2
    mode="$(_bbdl_prompt "Choice" "1")" || return 1

    choices="$tmpdir/download_choices.tsv"
    : > "$choices"

    case "$mode" in
      1)
        n="$(_bbdl_prompt "How many newest downloads?" "25")" || return 1
        [[ "$n" =~ ^[0-9]+$ ]] || n=25
        (( n > 0 )) || n=25
        if _bbdl_use_cache; then
          _bbdl_render_choices_from_jsonl "$cache_file" "$choices" "$n" || return 1
        else
          pagelen="$n"
          (( pagelen < 10 )) && pagelen=10
          (( pagelen > 100 )) && pagelen=100
          tmp_limited="$tmpdir/newest.jsonl"
          echo "Fetching newest $n downloads..." >&2
          if _bbdl_fetch_downloads_to_file "$(_bbdl_downloads_url "$pagelen" "-created_on")" "$tmp_limited" "$n" 1; then
            _bbdl_render_choices_from_jsonl "$tmp_limited" "$choices" "$n" || return 1
            _bbdl_start_background_refresh
          else
            echo "Newest-only request failed; fetching all downloads so they can be sorted locally." >&2
            _bbdl_refresh_cache_foreground || return 1
            _bbdl_render_choices_from_jsonl "$cache_file" "$choices" "$n" || return 1
          fi
        fi
        ;;
      2)
        query="$(_bbdl_prompt "Filename search")" || return 1
        if _bbdl_use_cache; then
          _bbdl_render_choices_from_jsonl "$cache_file" "$choices" 0 "$query" || return 1
        elif command -v fzf >/dev/null 2>&1; then
          mkdir -p "$cache_dir" || return 1
          cache_tmp="${cache_file}.$$.$RANDOM.tmp"
          echo "Streaming filename matches from Bitbucket. fzf will update as pages arrive." >&2
          selected="$(_bbdl_stream_pick "$query" "$(_bbdl_downloads_url 100 "")" "$cache_tmp")" || selected=""
          rm -f "$cache_tmp"
          [[ -n "$selected" ]] || {
            echo "No selection." >&2
            continue
          }
        else
          echo "Fetching downloads and searching filenames as pages arrive..." >&2
          _bbdl_refresh_cache_foreground || return 1
          _bbdl_render_choices_from_jsonl "$cache_file" "$choices" 0 "$query" || return 1
        fi
        ;;
      3)
        if ! _bbdl_use_cache; then
          _bbdl_refresh_cache_foreground || return 1
        fi
        _bbdl_render_choices_from_jsonl "$cache_file" "$choices" || return 1
        ;;
      *)
        echo "Invalid choice." >&2
        continue
        ;;
    esac

    if [[ -z "$selected" && ! -s "$choices" ]]; then
      echo "No matches." >&2
      continue
    fi

    if [[ -z "$selected" ]]; then
      selected="$(_bbdl_choose_line "Download" "$choices")" || return 1
    fi
    IFS=$'\t' read -r name size created href <<< "$selected"

    _bbdl_download_file "$name" "$href" || return 1

    again="$(_bbdl_prompt "Download another from $workspace/$repo?" "N")" || return 1
    [[ "$again" =~ ^[Yy]$ ]] || break
  done
)
