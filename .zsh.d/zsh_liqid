_liqid_load_dotfiles_env() {
  local env_file="${DOTFILES_ENV_FILE:-$HOME/dotfiles/.env}"

  if [[ -r "$env_file" ]]; then
    set -a
    source "$env_file"
    set +a
  elif [[ -r "$HOME/.env" ]]; then
    set -a
    source "$HOME/.env"
    set +a
  fi
}

_liqid_need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required tool: $1" >&2
    return 1
  }
}

_liqid_trim() {
  printf '%s' "$1" | awk '{$1=$1}1'
}

_liqid_docker_username() {
  printf '%s' "${LIQID_DOCKER_USERNAME:-${DOCKER_HUB_USERNAME:-${DOCKER_USERNAME:-}}}"
}

_liqid_docker_password() {
  printf '%s' "${LIQID_DOCKER_PASSWORD:-${DOCKER_HUB_PASSWORD:-${DOCKER_PASSWORD:-}}}"
}

_liqid_docker_image() {
  printf '%s' "${LIQID_DOCKER_IMAGE:-liqid/liqid}"
}

_liqid_dev_container() {
  printf '%s' "${LIQID_DEV_CONTAINER:-dev}"
}

_liqid_local_tags() {
  docker images "$(_liqid_docker_image)" --format '{{.Tag}}'
}

_liqid_remote_tags() {
  local image token user pass tag_pattern

  image="$(_liqid_docker_image)"
  user="$(_liqid_trim "$(_liqid_docker_username)")"
  pass="$(_liqid_trim "$(_liqid_docker_password)")"
  tag_pattern="${LIQID_DOCKER_TAG_PATTERN:-^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$}"

  if [[ -z $user || -z $pass ]]; then
    return 2
  fi

  token=$(
    curl -fsS -u "${user}:${pass}" \
      "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${image}:pull" \
      | jq -r '.token // empty'
  ) || return 1

  [[ -n $token ]] || return 1

  curl -fsS -H "Authorization: Bearer $token" \
    "https://registry-1.docker.io/v2/${image}/tags/list" \
    | jq -r '.tags[]' 2>/dev/null \
    | grep -E "$tag_pattern" \
    | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n
}

_liqid_prompt_for_tag() {
  local choice

  printf 'Enter tag manually: ' >&2
  IFS= read -r choice
  printf '%s' "$choice"
}

_liqid_select_local_tag() {
  local image make_tag tag
  local -a tags

  image="$(_liqid_docker_image)"

  while IFS= read -r tag; do
    [[ -n $tag ]] && tags+=("$tag")
  done < <(_liqid_local_tags)

  echo "Local ${image} tags:" >&2
  select make_tag in "${tags[@]}" "Pull new tag"; do
    [[ -n $make_tag ]] && {
      printf '%s' "$make_tag"
      return 0
    }
    echo "Invalid selection" >&2
  done
}

_liqid_select_remote_tag() {
  local remote_output remote_status choice tag
  local -a remote

  remote_output="$(_liqid_remote_tags)"
  remote_status=$?

  if [[ $remote_status -eq 2 ]]; then
    echo "LIQID_DOCKER_USERNAME/LIQID_DOCKER_PASSWORD not set." >&2
    echo "Tip: use 'docker login' instead, or set the vars in dotfiles/.env." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  if [[ $remote_status -ne 0 ]]; then
    echo "Auth failed or tags could not be fetched. Check username/PAT and repo access." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  while IFS= read -r tag; do
    [[ -n $tag ]] && remote+=("$tag")
  done <<< "$remote_output"

  if (( ${#remote[@]} == 0 )); then
    echo "No matching remote tags retrieved." >&2
    _liqid_prompt_for_tag
    return 0
  fi

  echo "Available remote tags:" >&2
  select choice in "${remote[@]}"; do
    [[ -n $choice ]] && {
      printf '%s' "$choice"
      return 0
    }
    echo "Invalid selection" >&2
  done
}

_liqid_dev_make() {
  local image container make_tag choice tag

  _liqid_need docker || return 1
  _liqid_need jq || {
    echo "Install jq to list/filter tags." >&2
    return 1
  }

  image="$(_liqid_docker_image)"
  container="$(_liqid_dev_container)"

  if docker ps -a --format '{{.Names}}' | grep -qx "$container"; then
    docker stop "$container" >/dev/null
    docker rm "$container" >/dev/null
  fi

  make_tag="$(_liqid_select_local_tag)" || return 1

  if [[ $make_tag == "Pull new tag" ]]; then
    echo "Fetching remote tags for ${image}..."
    choice="$(_liqid_select_remote_tag)" || return 1
    [[ -n $choice ]] && docker pull "${image}:${choice}"
  fi

  tag="${choice:-$make_tag}"
  [[ -n $tag ]] || {
    echo "No tag selected." >&2
    return 1
  }

  docker run -d \
    --name "$container" \
    --network host \
    -v "$HOME/code":/mnt/code \
    -v "$HOME/.ssh":/root/.ssh:ro \
    -v "$HOME/bin/devsync":/usr/local/bin/devsync:ro \
    "${image}:${tag}"
}

liqid_dev() {
  local cmd container
  local -a cmds

  _liqid_load_dotfiles_env

  cmds=(make enter sync exec help)
  container="$(_liqid_dev_container)"

  if [[ $# -eq 0 ]]; then
    echo "Select Liqid dev command:"
    select cmd in "${cmds[@]}"; do
      [[ -n $cmd ]] && set -- "$cmd" && break
      echo "Invalid selection" >&2
    done
  fi

  case "$1" in
    make)
      _liqid_dev_make
      ;;
    enter)
      docker exec -it "$container" bash --login -i
      ;;
    sync)
      docker exec -it "$container" bash -lc devsync
      ;;
    exec)
      shift
      docker exec -it "$container" bash -lc "$*"
      ;;
    help|*)
      cat <<EOF
Usage: liqid_dev <command>

Commands:
  make    Build and start a fresh Liqid dev container
  enter   Exec into the Liqid dev container with an interactive bash shell
  sync    Run devsync inside the Liqid dev container
  exec    Run an arbitrary command inside the Liqid dev container
  help    Show this message
EOF
      ;;
  esac
}

dev() {
  liqid_dev "$@"
}
