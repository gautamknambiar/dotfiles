# Git aliases
alias g="git"
alias gs="git status"
alias gst="git stash"
alias gstl="git stash list"
alias gstp="git stash pop"
alias ga="git add"
alias gps="git push origin --force"
alias gpl="git pull origin"
alias gcm="git commit"
alias gcma="git commit --amend"
alias gcmu="git reset --soft HEAD~1"
alias glg="git log"

ugit_parsed_args=()

ugit_confirm() {
    local reply

    printf '%s [y/N] ' "$1"
    IFS= read -r reply
    [[ "$reply" == [Yy] || "$reply" == [Yy][Ee][Ss] ]]
}

git_parse_args() {
    local -a args
    local arg
    local index
    local branch_name

    args=("$@")
    ugit_parsed_args=()

    for arg in "${args[@]}"; do
        if [[ $arg =~ ^b([0-9]+)$ ]]; then
            index=${arg#b}
            branch_name=$(git branch --format='%(refname:short)' | sed -n "${index}p")
            if [[ -z $branch_name ]]; then
                echo "Branch index $index does not exist." >&2
                return 1
            fi
            ugit_parsed_args+=("$branch_name")
        else
            ugit_parsed_args+=("$arg")
        fi
    done
}

testargs() {
    local i=0
    local arg

    git_parse_args "$@" || return 1

    for arg in "${ugit_parsed_args[@]}"; do
        echo "[$i]: $arg"
        ((i++))
    done
}

crb() {
    local main_branch
    local feature_branch
    local commit_message
    local temp_patch_file

    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"

    if (( $# < 2 || $# > 3 )); then
        echo "Usage: crb <main-branch> <feature-branch> [commit-message]"
        return 1
    fi

    main_branch=$1
    feature_branch=$2
    commit_message=${3:-}
    temp_patch_file=$(mktemp "${TMPDIR:-/tmp}/ugit-crb.XXXXXX") || return 1

    if ! ugit_confirm "Execute command 'crb ${main_branch} ${feature_branch}${commit_message:+ \"${commit_message}\"}'?"; then
        echo "Aborting"
        rm -f "$temp_patch_file"
        return 1
    fi

    git checkout "$main_branch" || { rm -f "$temp_patch_file"; echo "Failed to checkout $main_branch"; return 1; }
    git diff "$main_branch" "$feature_branch" > "$temp_patch_file" || { rm -f "$temp_patch_file"; echo "Failed to generate diff"; return 1; }
    git branch -D "$feature_branch" || { rm -f "$temp_patch_file"; echo "Failed to delete local $feature_branch"; return 1; }
    git checkout -b "$feature_branch" || { rm -f "$temp_patch_file"; echo "Failed to create new $feature_branch"; return 1; }
    git apply --reject --whitespace=fix "$temp_patch_file" || { rm -f "$temp_patch_file"; echo "Failed to apply patch"; return 1; }

    rm -f "$temp_patch_file"

    if [[ -n $commit_message ]]; then
        git add . || { echo "Failed to add changes"; return 1; }
        git commit -m "$commit_message" || { echo "Failed to commit changes"; return 1; }
        echo "Changes applied to $feature_branch and committed."
    else
        echo "Changes applied to $feature_branch without commit."
    fi

    echo "Clean branch $feature_branch created successfully."
}

mrb() {
    local original_branch
    local prev_branch

    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"

    if (( $# < 2 )); then
        echo "Usage: mrb branch1 branch2 [branch3 ...]"
        return 1
    fi

    if ! ugit_confirm "Execute command 'mrb $*'?"; then
        echo "Aborting"
        return 1
    fi

    original_branch=$1
    shift

    for prev_branch in "$@"; do
        git checkout "$prev_branch" || { echo "Failed to checkout $prev_branch"; return 1; }
        git rebase "$original_branch" || { echo "Rebase failed for $prev_branch onto $original_branch"; return 1; }
        original_branch="$prev_branch"
    done

    git checkout "$original_branch" || { echo "Failed to checkout back to $original_branch"; return 1; }
}

gb() {
    local output
    local exit_code
    local line
    local content
    local clean_content
    local branch
    local matched_branch
    local i
    local should_index=1
    local -a branches
    local -a indexed_lines

    (( $# == 0 )) && set -- -vv

    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"

    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Not a git repository"; return 1; }
    while IFS= read -r branch; do
        branches+=("$branch")
    done < <(git branch --format='%(refname:short)')

    output=$(git branch --color=always "$@")
    exit_code=$?

    if (( exit_code != 0 )); then
        [[ -n $output ]] && printf '%s\n' "$output"
        return "$exit_code"
    fi

    [[ -z $output ]] && return 0

    while IFS= read -r line; do
        if [[ -z $line ]]; then
            indexed_lines+=("")
            continue
        fi

        clean_content=$(printf '%s\n' "$line" | sed -E $'s/\x1B\\[[0-9;]*[[:alpha:]]//g')
        content="$clean_content"
        case "$content" in
            \*\ *) content="${content#\* }" ;;
            "  "*) content="${content#  }" ;;
        esac

        matched_branch=""
        i=1
        for branch in "${branches[@]}"; do
            if [[ $content == "$branch" || $content == "$branch "* ]]; then
                matched_branch=$branch
                indexed_lines+=($'\033[37m[\033[94m'"$i"$'\033[37m]\033[0m '"$line")
                break
            fi
            ((i++))
        done

        if [[ -z $matched_branch ]]; then
            should_index=0
            break
        fi
    done <<< "$output"

    if (( should_index == 1 )); then
        printf '%s\n' "${indexed_lines[@]}"
    else
        printf '%s\n' "$output"
    fi
}

gamend() {
    if [[ "$(uname)" == "Darwin" ]]; then
        osascript "$HOME/dotfiles/Scripts/amend.applescript" &
    else
        echo "gamend is only available on macOS"
        return 1
    fi
}

gch() {
    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"
    git checkout "$@"
}

gmr() {
    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"
    git merge "$@"
}

grb() {
    git_parse_args "$@" || return 1
    set -- "${ugit_parsed_args[@]}"
    git rebase "$@"
}

gpsu() {
    local branch

    branch=$(git rev-parse --abbrev-ref HEAD) || return 1
    git push --force --set-upstream origin "$branch"
}
