# Copy this file to ${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/env and
# fill in local-only values. That destination is outside the repository.

LIQID_DOCKER_USERNAME=
LIQID_DOCKER_PASSWORD=
LIQID_DOCKER_IMAGE=liqid/liqid
LIQID_DEV_CONTAINER=dev
LIQID_DEV_CODE_DIR=$HOME/code
LIQID_DEVSYNC_BIN=$HOME/bin/devsync
LIQID_DEV_NETWORK=host
LIQID_DOCKER_TAG_PATTERN=^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$
