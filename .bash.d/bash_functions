# General Functions

__bash_emit() {
    local output_file="$1"
    shift

    if [[ -n "$output_file" ]]; then
        printf "$@" >> "$output_file"
    else
        printf "$@"
    fi
}

source_bash_d_files() {
    local output_file="${1:-}"
    local output_style="${2:-terminal}"
    local bash_d="${BASH_D:-$HOME/.bash.d}"
    local total_length=45
    local totalfiles=0
    local color_start=""
    local color_end=""

    case "$output_style" in
        fastfetch)
            color_start='$2'
            color_end='$1'
            ;;
        terminal)
            color_start="${FG_GREEN:-}"
            color_end="${TXT_RESET:-}"
            ;;
    esac

    if [[ -d "$bash_d" ]]; then
        __bash_emit "$output_file" "╔═════════════════════════════════════════════╗\n"
        __bash_emit "$output_file" "║                %sSOURCED FILES%s                ║\n" "$color_start" "$color_end"
        __bash_emit "$output_file" "╠═════════════════════════════════════════════╣\n"

        for file in "$bash_d"/*; do
            if [[ -f "$file" && -r "$file" ]]; then
                ((totalfiles++))
                source "$file"

                local filename
                local filename_length
                local padding_length
                local padding=""
                local i

                filename=$(basename "$file")
                filename_length=${#filename}
                padding_length=$(( (total_length - filename_length) / 2 ))

                for ((i=0; i<padding_length; i++)); do
                    padding+=" "
                done

                if (( (total_length - filename_length) % 2 != 0 )); then
                    filename="$filename "
                fi

                __bash_emit "$output_file" "║%s%s%s%s%s║\n" "$padding" "$color_start" "$filename" "$color_end" "$padding"
            fi
        done

        __bash_emit "$output_file" "╚═════════════════════════════════════════════╝"
    else
        echo "Directory $bash_d does not exist."
        return 1
    fi

    SOURCE_BASH_D_TOTALFILES=$totalfiles
}

show_daily_fastfetch() {
    local logo_file="${LOGO_FILE:-$HOME/.config/fastfetch/logo.txt}"
    local config_file="${CONFIG_FILE:-$HOME/.config/fastfetch/config_src.jsonc}"
    local newcomp_file="$HOME/.config/fastfetch/newcomp.txt"
    local top_value

    [[ -f "$newcomp_file" ]] || return 0
    [[ -f "$config_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    command -v fastfetch >/dev/null 2>&1 || return 0

    cat "$newcomp_file" > "$logo_file"
    printf "\n" >> "$logo_file"

    if ! source_bash_d_files "$logo_file" fastfetch; then
        rm -f "$logo_file"
        return 1
    fi

    printf "\n" >> "$logo_file"

    top_value=$(( (13 - SOURCE_BASH_D_TOTALFILES) / 2 ))
    if (( top_value < 0 )); then
        top_value=0
    fi

    jq --argjson newTop "$top_value" '.logo.padding.top = $newTop' "$config_file" > "$config_file.tmp" && mv "$config_file.tmp" "$config_file"
    fastfetch --config "$config_file"
    rm -f "$logo_file"
}

bash_daily_motd() {
    local state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
    local stamp_dir="$state_home/shell-motd"
    local stamp_file="$stamp_dir/bash-fastfetch.last"
    local today

    today=$(date +%F)
    mkdir -p "$stamp_dir"

    if [[ -r "$stamp_file" ]] && [[ "$(cat "$stamp_file")" == "$today" ]]; then
        re-source
        return
    fi

    if show_daily_fastfetch; then
        printf '%s\n' "$today" > "$stamp_file"
    else
        re-source
    fi
}

# Re-source bash files
re-source() {
    source_bash_d_files "" terminal
    printf "\n"
}

# Recursively find a directory
cdfind() {
    local search_pattern="$1"
    local base_dir="${2:-.}"
    local found_dir

    if [[ -z "$search_pattern" ]]; then
        echo "Usage: cdfind <search-pattern> [base-directory]"
        return 1
    fi

    base_dir=$(eval echo "$base_dir")
    search_pattern="*$search_pattern"
    found_dir=$(find "$base_dir" -type d -path "$search_pattern" -print -quit 2>/dev/null)

    if [[ -n "$found_dir" ]]; then
        cd "$found_dir" || return 1
        echo "Changed directory to: $found_dir"
    else
        echo "Directory matching '$search_pattern' not found in '$base_dir'."
        return 1
    fi
}

# Watch tail of a file
wt() {
    if [ "$#" -ne 3 ]; then
        echo "Usage: wt <seconds> <lines> <file>"
        return 1
    fi

    local seconds=$1
    local lines=$2
    local file=$3

    if ! [[ "$seconds" =~ ^[0-9]+$ ]] || [ "$seconds" -le 0 ]; then
        echo "Error: <seconds> must be a positive integer."
        return 1
    fi

    if ! [[ "$lines" =~ ^[0-9]+$ ]] || [ "$lines" -le 0 ]; then
        echo "Error: <lines> must be a positive integer."
        return 1
    fi

    if [ ! -f "$file" ]; then
        echo "Error: File '$file' does not exist."
        return 1
    fi

    watch -n "$seconds" "tail -n $lines $file"
}

# User for ssh
user() {
    echo "$(whoami)@$(ifconfig en0 | grep 'inet ' | awk '{print $2}')"
}

# Print path with newlines
pathd() {
    if [[ -n "$1" ]]; then
        temp=$1
        echo -e "${temp//:/\\n}"
    else
        echo -e "${PATH//:/\\n}"
    fi
}

# Remove duplicates in path
cleanpath() {
    export OLD_PATH="$PATH"
    TEMP=$(echo "$OLD_PATH" | tr ':' '\n' | awk '!seen[$0]++' | tr '\n' ':' | sed 's/:$//')

    if [[ "$1" == "-d" ]]; then
        echo "Cleaned PATH without updating:"
        echo -e "${TEMP//:/\\n}"
    else
        export PATH="$TEMP"
        if [[ "$1" != "-q" ]]; then
            echo "Updated PATH:"
            pathd
        fi
    fi
}

# Undo cleanpath
revertpath() {
    if [[ -n "$OLD_PATH" ]]; then
        export PATH="$OLD_PATH"
        echo "Reverted to OLD_PATH:"
        pathd
    else
        echo "No old PATH found to revert to."
    fi
}

fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}
