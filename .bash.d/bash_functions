# General Functions

# Recursively find a directory
cdfind() {
    local search_pattern="$1"
    local base_dir="${2:-.}"
    local found_dir

    if [[ -z "$search_pattern" ]]; then
        echo "Usage: cdfind <search-pattern> [base-directory]"
        return 1
    fi

    case "$base_dir" in
        "~") base_dir="$HOME" ;;
        "~/"*) base_dir="$HOME/${base_dir#~/}" ;;
    esac

    search_pattern="*$search_pattern"
    found_dir=$(find "$base_dir" -type d -path "$search_pattern" -print -quit 2>/dev/null)

    if [[ -n "$found_dir" ]]; then
        cd "$found_dir" || return 1
        echo "Changed directory to: $found_dir"
    else
        echo "Directory matching '$search_pattern' not found in '$base_dir'."
        return 1
    fi
}

# Watch tail of a file
wt() {
    if [ "$#" -ne 3 ]; then
        echo "Usage: wt <seconds> <lines> <file>"
        return 1
    fi

    local seconds=$1
    local lines=$2
    local file=$3

    if ! [[ "$seconds" =~ ^[0-9]+$ ]] || [ "$seconds" -le 0 ]; then
        echo "Error: <seconds> must be a positive integer."
        return 1
    fi

    if ! [[ "$lines" =~ ^[0-9]+$ ]] || [ "$lines" -le 0 ]; then
        echo "Error: <lines> must be a positive integer."
        return 1
    fi

    if [ ! -f "$file" ]; then
        echo "Error: File '$file' does not exist."
        return 1
    fi

    watch -n "$seconds" "tail -n $lines $file"
}

# User for ssh
user() {
    local ip=""

    if [[ "$(uname)" == "Darwin" ]]; then
        ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
    elif command -v hostname >/dev/null 2>&1; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi

    if [[ -n "$ip" ]]; then
        printf '%s@%s\n' "$(whoami)" "$ip"
    else
        whoami
    fi
}

# Print path with newlines
pathd() {
    local path_value="${1:-$PATH}"

    printf '%s\n' "$path_value" | tr ':' '\n'
}

# Remove duplicates in path
cleanpath() {
    export OLD_PATH="$PATH"
    local cleaned_path

    cleaned_path=$(printf '%s\n' "$OLD_PATH" | tr ':' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ':' | sed 's/:$//')

    if [[ "$1" == "-d" ]]; then
        echo "Cleaned PATH without updating:"
        printf '%s\n' "$cleaned_path" | tr ':' '\n'
    else
        export PATH="$cleaned_path"
        if [[ "$1" != "-q" ]]; then
            echo "Updated PATH:"
            pathd
        fi
    fi
}

# Undo cleanpath
revertpath() {
    if [[ -n "$OLD_PATH" ]]; then
        export PATH="$OLD_PATH"
        echo "Reverted to OLD_PATH:"
        pathd
    else
        echo "No old PATH found to revert to."
    fi
}

clrzi() {
    local -a files
    local reply

    files=( *Zone.Identifier )

    if [[ ! -e "${files[0]}" ]]; then
        echo "No Zone.Identifier files found."
        return 0
    fi

    printf '%s\n' "${files[@]}"
    printf 'Remove these Zone.Identifier files? [y/N] '
    IFS= read -r reply

    if [[ "$reply" == [Yy] || "$reply" == [Yy][Ee][Ss] ]]; then
        rm -- "${files[@]}"
    else
        echo "Aborting"
        return 1
    fi
}

fs() {
    local arg

    if du -b /dev/null >/dev/null 2>&1; then
        arg=-sbh
    else
        arg=-sh
    fi

    if (( $# > 0 )); then
        du "$arg" -- "$@" | sort -hr
    else
        du "$arg" .[^.]* ./* 2>/dev/null | sort -hr
    fi
}

tre() {
    tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX
}
